# Copy to .env (never commit .env). Create the client at https://www.warcraftlogs.com/api/clients
WCL_CLIENT_ID=your_id_here
WCL_CLIENT_SECRET=your_secret_here

# Optional - hosted mode (every visitor signs in with Warcraft Logs):
# AUTH_MODE=wcl
# REDIRECT_URI=http://localhost:8000/callback
# SECURE_COOKIES=0        # only for plain-http local testing of hosted mode
# DATA_DIR=/data          # cache, sessions, per-user settings
